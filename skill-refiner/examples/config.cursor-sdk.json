{
  "schema_version": "skill-refiner.config/v1",
  "runtime_driver": "adk",
  "budgets": {
    "max_seconds": 1800,
    "max_agent_calls": 24,
    "max_evaluations": 40,
    "max_repair_rounds": 2,
    "per_call_timeout": 300,
    "concurrency": 1
  },
  "roles": {
    "planner": {"kind": "cursor_sdk", "model": "auto", "credential_env": ["CURSOR_API_KEY"], "timeout": 300},
    "author": {"kind": "cursor_sdk", "model": "auto", "credential_env": ["CURSOR_API_KEY"], "timeout": 300},
    "repair": {"kind": "cursor_sdk", "model": "auto", "credential_env": ["CURSOR_API_KEY"], "timeout": 300},
    "reviewer": {"kind": "cursor_sdk", "model": "auto", "credential_env": ["CURSOR_API_KEY"], "timeout": 300},
    "evaluator": {"kind": "cursor_sdk", "model": "auto", "credential_env": ["CURSOR_API_KEY"], "timeout": 300}
  },
  "executors": {}
}
