{
  "requirements": [
    {"id": "R-greet", "text": "Greet a supplied name"},
    {"id": "R-missing", "text": "Fail when a name is missing"}
  ],
  "work_items": [
    {
      "id": "W-greet",
      "title": "Implement deterministic greeting",
      "scope": ["scripts/hello.py greeting path", "SKILL.md usage contract"],
      "requirement_ids": ["R-greet"],
      "depends_on": [],
      "done_when": ["A supplied name produces the exact greeting and exit code 0"],
      "development_case_ids": ["C-dev-greet"],
      "acceptance_case_ids": ["C-accept-held-out"]
    },
    {
      "id": "W-missing",
      "title": "Reject a missing name",
      "scope": ["scripts/hello.py missing-argument path"],
      "requirement_ids": ["R-missing"],
      "depends_on": ["W-greet"],
      "done_when": ["A missing name prints usage and exits with code 2"],
      "development_case_ids": ["C-dev-missing"],
      "acceptance_case_ids": ["C-accept-missing"]
    }
  ],
  "development_cases": [
    {
      "id": "C-dev-greet",
      "kind": "normal",
      "requirement_ids": ["R-greet"],
      "argv": ["{python}", "scripts/hello.py", "Alice"],
      "assertions": [
        {"id": "A-dev-exit", "kind": "exit_code", "expected": 0},
        {"id": "A-dev-text", "kind": "stdout_contains", "expected": "Hello, Alice!"}
      ]
    },
    {
      "id": "C-dev-missing",
      "kind": "error",
      "requirement_ids": ["R-missing"],
      "argv": ["{python}", "scripts/hello.py"],
      "assertions": [
        {"id": "A-missing-exit", "kind": "exit_code", "expected": 2},
        {"id": "A-missing-text", "kind": "stdout_contains", "expected": "usage: hello.py NAME"}
      ]
    }
  ],
  "acceptance_cases": [
    {
      "id": "C-accept-held-out",
      "kind": "acceptance",
      "requirement_ids": ["R-greet"],
      "argv": ["{python}", "scripts/hello.py", "Bob"],
      "assertions": [
        {"id": "A-accept-exit", "kind": "exit_code", "expected": 0},
        {"id": "A-accept-text", "kind": "stdout_contains", "expected": "Hello, Bob!"}
      ]
    },
    {
      "id": "C-accept-missing",
      "kind": "acceptance",
      "requirement_ids": ["R-missing"],
      "argv": ["{python}", "scripts/hello.py"],
      "assertions": [
        {"id": "A-accept-missing-exit", "kind": "exit_code", "expected": 2},
        {"id": "A-accept-missing-text", "kind": "stdout_contains", "expected": "usage: hello.py NAME"}
      ]
    }
  ]
}
