{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.analysis-recovery",
  "x-schema-version": "v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "source_run", "source_manifest_sha256", "source_controller_sha256", "inputs_sha256", "pairs", "files"],
  "properties": {
    "schema_version": {"const": "skill-refiner.analysis-recovery/v1"},
    "mode": {"const": "rejected-analysis-evidence"},
    "source_run": {"type": "string", "minLength": 1},
    "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_controller_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "inputs_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pairs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["analysis_call", "review_call", "analysis_sha256", "review_sha256", "approved"],
      "properties": {"analysis_call": {"type": "string"}, "review_call": {"type": "string"},
        "analysis_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "review_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "approved": {"const": false}}}},
    "files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
  }
}
