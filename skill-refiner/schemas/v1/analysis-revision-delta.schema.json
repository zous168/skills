{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.analysis-revision-delta",
  "x-schema-version": "v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "previous_sha256", "revised_sha256", "requirements_added", "requirements_removed", "requirements_changed", "required_downgraded", "scenarios_added", "scenarios_removed", "scenarios_changed", "applicable_excluded"],
  "properties": {
    "schema_version": {"const": "skill-refiner.analysis-revision-delta/v1"},
    "previous_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revised_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requirements_added": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "requirements_removed": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "requirements_changed": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "required_downgraded": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "scenarios_added": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "scenarios_removed": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "scenarios_changed": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "applicable_excluded": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
