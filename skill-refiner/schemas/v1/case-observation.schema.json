{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.case-observation",
  "x-schema-version": "v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "run_sha256",
    "oracle_sha256",
    "response_sha256",
    "contract_sha256",
    "files",
    "transcript"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-refiner.case-observation/v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "run_sha256": {
      "$ref": "#/$defs/hash"
    },
    "oracle_sha256": {
      "$ref": "#/$defs/hash"
    },
    "response_sha256": {
      "$ref": "#/$defs/hash"
    },
    "contract_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "present",
          "content",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "present": {
            "type": "boolean"
          },
          "content": {
            "type": "boolean"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2097152
          },
          "sha256": {
            "anyOf": [
              {
                "$ref": "#/$defs/hash"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "bytes",
        "sha256"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
