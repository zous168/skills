{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.evaluation-cost",
  "x-schema-version": "v1",
  "title": "Controller evaluation attempt reservation and charged cost",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "status",
    "reserved_count",
    "charged_count",
    "cumulative_cost_before",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-refiner.evaluation-cost/v1"
    },
    "suite": {
      "type": "string",
      "pattern": "^(?:baseline|iterations/round-[0-9]+/regression|acceptance/attempts/(?:initial|round-[0-9]+)/evaluation)$"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "error"
      ]
    },
    "reserved_count": {
      "type": "integer",
      "minimum": 0
    },
    "charged_count": {
      "type": "integer",
      "minimum": 0
    },
    "cumulative_cost_before": {
      "type": "integer",
      "minimum": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "error": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "running"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "finished_at": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "finished_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
