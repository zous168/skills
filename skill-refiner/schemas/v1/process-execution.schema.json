{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.process-execution",
  "x-schema-version": "v1",
  "title": "本地进程执行记录",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "argv", "cwd", "pid", "status", "exit_code", "started_at", "finished_at", "elapsed_seconds", "timeout_seconds", "input_bytes", "stdout_bytes", "stderr_bytes", "last_output_at", "stdout_path", "stderr_path", "error"],
  "properties": {
    "schema_version": {"const": "skill-refiner.process-execution/v1"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cwd": {"type": ["string", "null"]},
    "pid": {"type": ["integer", "null"], "minimum": 1},
    "status": {"enum": ["starting", "running", "completed", "execution_error", "timed_out", "cancelled", "launch_error", "termination_unconfirmed"]},
    "exit_code": {"type": ["integer", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "timeout_seconds": {"type": ["number", "null"], "minimum": 0},
    "input_bytes": {"type": "integer", "minimum": 0},
    "stdout_bytes": {"type": "integer", "minimum": 0},
    "stderr_bytes": {"type": "integer", "minimum": 0},
    "last_output_at": {"type": ["string", "null"], "format": "date-time"},
    "stdout_path": {"type": "string", "minLength": 1},
    "stderr_path": {"type": "string", "minLength": 1},
    "error": {"type": ["string", "null"]}
  }
}
