{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.refine-budget-cap-migration",
  "x-schema-version": "v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "source_run",
    "lineage_id",
    "source_state_sha256",
    "source_resume_contract_sha256",
    "approved_limits",
    "approval_artifact_path",
    "approval_artifact_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-refiner.refine-budget-cap-migration/v1"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "source_run": {
      "type": "string",
      "minLength": 1
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1,
      "description": "Must equal the source_run directory basename, binding this migration to that exact existing refine lineage."
    },
    "source_state_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_resume_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approved_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_agent_calls",
        "max_seconds",
        "max_evaluations"
      ],
      "properties": {
        "max_agent_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_evaluations": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "approval_artifact_path": {
      "type": "string",
      "minLength": 1
    },
    "approval_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
