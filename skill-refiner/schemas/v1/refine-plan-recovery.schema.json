{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.refine-plan-recovery",
  "x-schema-version": "v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_run",
    "source_controller_sha256",
    "source_contract_sha256",
    "source_state_sha256",
    "source_stages_sha256",
    "source_files",
    "source_omissions",
    "latest_call",
    "latest_response_text_sha256",
    "schema_errors",
    "requirement_ids",
    "case_ids",
    "usage",
    "ancestor"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-refiner.refine-plan-recovery/v1"
    },
    "source_run": {
      "type": "string",
      "minLength": 1
    },
    "source_controller_sha256": {
      "$ref": "#/$defs/hash"
    },
    "source_contract_sha256": {
      "$ref": "#/$defs/hash"
    },
    "source_state_sha256": {
      "$ref": "#/$defs/hash"
    },
    "source_stages_sha256": {
      "$ref": "#/$defs/hash"
    },
    "source_files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/hash"
      }
    },
    "source_omissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "latest_call": {
      "type": "string",
      "pattern": "^[0-9]+-plan$"
    },
    "latest_response_text_sha256": {
      "$ref": "#/$defs/hash"
    },
    "schema_errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "schema_path",
          "constraint",
          "expected",
          "actual",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "schema_path": {
            "type": "string"
          },
          "constraint": {
            "type": "string"
          },
          "expected": {},
          "actual": {},
          "message": {}
        }
      }
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_calls",
        "elapsed_seconds",
        "target_evaluations"
      ],
      "properties": {
        "agent_calls": {
          "type": "integer",
          "minimum": 1
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "target_evaluations": {
          "const": 0
        }
      }
    },
    "ancestor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "state_sha256",
        "contract_sha256",
        "agent_calls",
        "elapsed_seconds",
        "target_evaluations",
        "stages_sha256",
        "evidence"
      ],
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "state_sha256": {
          "$ref": "#/$defs/hash"
        },
        "contract_sha256": {
          "$ref": "#/$defs/hash"
        },
        "agent_calls": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "target_evaluations": {
          "const": 0
        },
        "stages_sha256": {
          "$ref": "#/$defs/hash"
        },
        "evidence": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
