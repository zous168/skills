{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.stages/v1",
  "type": "object",
  "required": ["schema_version", "contract_sha256", "stages"],
  "properties": {
    "schema_version": {"const": "skill-refiner.stages/v1"},
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stages": {
      "type": "array", "minItems": 14, "maxItems": 14,
      "items": {
        "type": "object",
        "required": ["stage_id", "ordinal", "status", "attempt", "input_sha256", "output_sha256", "input_path", "output_path", "envelope_path", "started_at", "finished_at", "error_code", "error_message"],
        "properties": {
          "stage_id": {"type": "string"}, "ordinal": {"type": "integer", "minimum": 1},
          "status": {"enum": ["pending", "running", "passed", "failed", "skipped"]},
          "attempt": {"type": "integer", "minimum": 0},
          "input_sha256": {"type": ["string", "null"]}, "output_sha256": {"type": ["string", "null"]},
          "input_path": {"type": ["string", "null"]}, "output_path": {"type": ["string", "null"]},
          "envelope_path": {"type": ["string", "null"]}, "started_at": {"type": ["string", "null"]},
          "finished_at": {"type": ["string", "null"]}, "error_code": {"type": ["string", "null"]},
          "error_message": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
