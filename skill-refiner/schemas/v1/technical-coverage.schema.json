{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "skill-refiner.technical-coverage", "x-schema-version": "v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "analysis_sha256", "questions", "observation", "resolution"],
  "properties": {
    "schema_version": {"const": "skill-refiner.technical-coverage/v1"},
    "status": {"const": "coverage_gap"},
    "analysis_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "questions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["question_id", "question", "reason", "requirement_ids", "scenario_ids"], "properties": {
        "question_id": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 12},
        "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "scenario_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "observation": {"type": "object", "additionalProperties": false,
      "required": ["probe", "command_event_visible", "noncommand_fixture_visible", "limitations"], "properties": {
        "probe": {"type": "string", "minLength": 1}, "command_event_visible": {"type": "boolean"},
        "noncommand_fixture_visible": {"type": "boolean"},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "resolution": {"type": "string", "minLength": 12}
  }
}
