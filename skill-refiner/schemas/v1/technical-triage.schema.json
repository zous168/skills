{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "skill-refiner.technical-triage", "x-schema-version": "v1",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "assessments"],
  "properties": {
    "schema_version": {"const": "skill-refiner.technical-triage/v1"},
    "assessments": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["question_id", "domain", "reason", "requirement_ids", "scenario_ids"],
      "properties": {
        "question_id": {"type": "string", "minLength": 1},
        "domain": {"enum": ["technical_evidence", "business_decision", "uncertain"]},
        "reason": {"type": "string", "minLength": 12},
        "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "scenario_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "allOf": [{"if": {"properties": {"domain": {"const": "technical_evidence"}}},
                 "then": {"properties": {"requirement_ids": {"minItems": 1}, "scenario_ids": {"minItems": 1}}}}]
    }}
  }
}
