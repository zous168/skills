{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.user-approval-record/v1",
  "x-schema-version": "v1",
  "title": "Refiner 用户执行批准记录",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "run_id",
    "mode",
    "trigger",
    "stage_id",
    "case_id",
    "purpose",
    "action",
    "input_refs",
    "backend",
    "budget",
    "write_scope",
    "decision",
    "decision_summary",
    "requested_at",
    "responded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-refiner.user-approval-record/v1"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^APR-[0-9]{3,}$"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "mode": {
      "enum": [
        "create",
        "refine"
      ]
    },
    "trigger": {
      "enum": [
        "workflow_start",
        "problem_recovery"
      ]
    },
    "stage_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 5
    },
    "action": {
      "type": "string",
      "minLength": 5
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model",
        "executor"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "executor": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_seconds",
        "max_agent_calls",
        "max_evaluations"
      ],
      "properties": {
        "max_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "max_agent_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_evaluations": {
          "type": "integer",
          "minimum": 0
        },
        "max_repair_rounds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "write_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision": {
      "enum": [
        "approved",
        "declined",
        "deferred"
      ]
    },
    "decision_summary": {
      "type": "string",
      "minLength": 3
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "trigger": {
            "const": "workflow_start"
          }
        },
        "required": [
          "trigger"
        ]
      },
      "then": {
        "properties": {
          "stage_id": {
            "type": "null"
          },
          "case_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "trigger": {
            "const": "problem_recovery"
          }
        },
        "required": [
          "trigger"
        ]
      },
      "then": {
        "properties": {
          "stage_id": {
            "type": "string"
          }
        }
      }
    }
  ]
}
