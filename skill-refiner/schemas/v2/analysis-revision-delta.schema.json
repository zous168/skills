{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.analysis-revision-delta-v2",
  "x-schema-version": "v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "previous_sha256",
    "revised_sha256",
    "requirements_added",
    "requirements_removed",
    "requirements_changed",
    "required_downgraded",
    "scenarios_added",
    "scenarios_removed",
    "scenarios_changed",
    "applicable_excluded",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-refiner.analysis-revision-delta/v2"
    },
    "previous_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revised_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requirements_added": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "requirements_removed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "requirements_changed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "required_downgraded": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "scenarios_added": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "scenarios_removed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "scenarios_changed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "applicable_excluded": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "before",
          "after",
          "before_sha256",
          "after_sha256",
          "changed_paths"
        ],
        "properties": {
          "kind": {
            "enum": [
              "requirement",
              "scenario"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": "object"
          },
          "after": {
            "type": [
              "object",
              "null"
            ]
          },
          "before_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "after_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "changed_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
