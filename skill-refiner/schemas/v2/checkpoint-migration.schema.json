{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.checkpoint-migration-v2",
  "x-schema-version": "v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "workspace", "source_run", "controller_archive", "source_controller_sha256", "source_manifest_sha256", "source_contract_sha256", "source_state_sha256", "process_reconciliation_sha256", "source_inputs_sha256", "source_artifacts", "supplement", "inputs_sha256", "artifacts", "inherited", "execution_sha256", "options", "limits"],
  "properties": {
    "schema_version": {"const": "skill-refiner.checkpoint-migration/v2"},
    "mode": {"const": "append-user-requirement"},
    "workspace": {"type": "string", "minLength": 1},
    "source_run": {"type": "string", "minLength": 1},
    "controller_archive": {"type": "string", "minLength": 1},
    "source_controller_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "process_reconciliation_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "source_inputs_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_artifacts": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "supplement": {"type": "object", "additionalProperties": false, "required": ["source_path", "source_sha256", "decision_source", "artifact_path", "requirement_index"], "properties": {
      "source_path": {"type": "string", "minLength": 1},
      "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "decision_source": {"type": "string", "minLength": 3},
      "artifact_path": {"type": "string", "pattern": "^inputs/requirement-[1-9][0-9]*\\.md$"},
      "requirement_index": {"type": "integer", "minimum": 1}
    }},
    "inputs_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifacts": {"type": "object", "minProperties": 3, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "inherited": {"type": "object", "additionalProperties": false, "required": ["seconds", "agent_calls", "evaluations"], "properties": {"seconds": {"type": "number", "minimum": 0}, "agent_calls": {"type": "integer", "minimum": 0}, "evaluations": {"const": 0}}},
    "execution_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "options": {"type": "object"},
    "limits": {"type": "object"}
  }
}
