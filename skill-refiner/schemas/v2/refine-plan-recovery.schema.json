{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.refine-plan-recovery/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_run",
    "source_controller_sha256",
    "source_snapshot_sha256",
    "source_files",
    "archive_files",
    "lineage",
    "usage",
    "ancestor",
    "control_paths",
    "latest_plan_call"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-refiner.refine-plan-recovery/v2"
    },
    "source_run": {
      "type": "string",
      "minLength": 1
    },
    "source_controller_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "archive_files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "lineage": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_calls",
        "elapsed_seconds",
        "target_evaluations"
      ],
      "properties": {
        "agent_calls": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "target_evaluations": {
          "const": 0
        }
      }
    },
    "ancestor": {
      "type": "object"
    },
    "control_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "latest_plan_call": {
      "type": "string",
      "pattern": "^[0-9]+-plan$"
    }
  }
}
