{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.checkpoint-migration-v3",
  "x-schema-version": "v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace", "source_run", "controller_archive", "source_controller_sha256", "source_manifest_sha256", "source_contract_sha256", "source_state_sha256", "process_reconciliation_sha256", "inputs_sha256", "artifacts", "inherited", "execution_sha256", "options", "limits", "controller_attestation"],
  "properties": {
    "schema_version": {"const": "skill-refiner.checkpoint-migration/v3"},
    "workspace": {"type": "string", "minLength": 1},
    "source_run": {"type": "string", "minLength": 1},
    "controller_archive": {"type": "null"},
    "source_controller_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "process_reconciliation_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "inputs_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifacts": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "inherited": {"type": "object", "additionalProperties": false, "required": ["seconds", "agent_calls", "evaluations"], "properties": {"seconds": {"type": "number", "minimum": 0}, "agent_calls": {"type": "integer", "minimum": 0}, "evaluations": {"const": 0}}},
    "execution_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "options": {"type": "object"},
    "limits": {"type": "object"},
    "controller_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_status", "validation_method", "source_controller_sha256", "validation_controller_sha256", "validated_completed_stage_ids", "untrusted_stage_ids"],
      "properties": {
        "archive_status": {"const": "unavailable"},
        "validation_method": {"const": "current-controller-stage-schema-and-content-hash-revalidation"},
        "source_controller_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "validation_controller_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "validated_completed_stage_ids": {"const": ["inputs"]},
        "untrusted_stage_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
