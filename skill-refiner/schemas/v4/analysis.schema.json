{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "goal",
    "context",
    "scope",
    "actors",
    "requirements",
    "workflow",
    "scenarios",
    "risk_assessments",
    "assumptions",
    "external_dependencies",
    "blocking_questions",
    "target_obligations"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-refiner.analysis/v4"
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "goal": {
      "type": "string",
      "minLength": 8
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_intent",
        "usage_context",
        "primary_user_ids"
      ],
      "properties": {
        "user_intent": {
          "type": "string",
          "minLength": 8
        },
        "usage_context": {
          "type": "string",
          "minLength": 8
        },
        "primary_user_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "out_of_scope",
        "constraints"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "out_of_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "needs",
          "permission_boundary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "role": {
            "type": "string",
            "minLength": 3
          },
          "needs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "permission_boundary": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "behavior",
          "source",
          "required",
          "acceptance_criteria"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "behavior": {
            "type": "string",
            "minLength": 8
          },
          "source": {
            "type": "string",
            "minLength": 3
          },
          "required": {
            "type": "boolean"
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "statement",
                "evidence"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "statement": {
                  "type": "string",
                  "minLength": 8
                },
                "evidence": {
                  "type": "string",
                  "minLength": 8
                }
              }
            }
          }
        }
      }
    },
    "workflow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "action",
          "actor_ids",
          "preconditions",
          "inputs",
          "outputs",
          "completion_check",
          "failure_behavior",
          "requirement_ids",
          "dependency_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "minLength": 3
          },
          "actor_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "preconditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "inputs": {
            "type": "string",
            "minLength": 3
          },
          "outputs": {
            "type": "string",
            "minLength": 3
          },
          "completion_check": {
            "type": "string",
            "minLength": 8
          },
          "failure_behavior": {
            "type": "string",
            "minLength": 8
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependency_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "applicable",
          "situation",
          "requirement_ids",
          "acceptance_criteria_ids",
          "detail",
          "basis",
          "exclusion_reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "kind": {
            "enum": [
              "normal",
              "boundary",
              "error",
              "negative",
              "regression"
            ]
          },
          "applicable": {
            "type": "boolean"
          },
          "situation": {
            "type": "string",
            "minLength": 8
          },
          "requirement_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "detail": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "preconditions",
                  "stimulus",
                  "actions",
                  "expected_observables",
                  "forbidden_outcomes",
                  "risk_dimensions",
                  "basis"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "allOf": [
                      {
                        "if": {
                          "not": {
                            "pattern": "[\\u3400-\\u9fff]{2}"
                          }
                        },
                        "then": {
                          "minLength": 8
                        }
                      }
                    ]
                  },
                  "preconditions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 3
                    }
                  },
                  "stimulus": {
                    "type": "string",
                    "minLength": 8
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 3
                    }
                  },
                  "expected_observables": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 5
                    }
                  },
                  "forbidden_outcomes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "allOf": [
                        {
                          "if": {
                            "not": {
                              "pattern": "[\\u3400-\\u9fff]{2}"
                            }
                          },
                          "then": {
                            "minLength": 5
                          }
                        }
                      ]
                    }
                  },
                  "risk_dimensions": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "input_variation",
                        "workflow_state",
                        "role_permission",
                        "dependency_failure",
                        "cross_requirement",
                        "side_effect",
                        "retry_recovery",
                        "idempotency",
                        "ambiguity_conflict",
                        "asset_handling",
                        "safety_boundary",
                        "other"
                      ]
                    }
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 12
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 12
          },
          "exclusion_reason": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "applicable": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "exclusion_reason": {
                  "type": "string",
                  "minLength": 12
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "applicable": {
                  "const": true
                }
              },
              "required": [
                "applicable"
              ]
            },
            "then": {
              "properties": {
                "requirement_ids": {
                  "minItems": 1
                },
                "acceptance_criteria_ids": {
                  "minItems": 1
                },
                "detail": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "preconditions",
                    "stimulus",
                    "actions",
                    "expected_observables",
                    "forbidden_outcomes",
                    "risk_dimensions",
                    "basis"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "allOf": [
                        {
                          "if": {
                            "not": {
                              "pattern": "[\\u3400-\\u9fff]{2}"
                            }
                          },
                          "then": {
                            "minLength": 8
                          }
                        }
                      ]
                    },
                    "preconditions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 3
                      }
                    },
                    "stimulus": {
                      "type": "string",
                      "minLength": 8
                    },
                    "actions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 3
                      }
                    },
                    "expected_observables": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 5
                      }
                    },
                    "forbidden_outcomes": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "allOf": [
                          {
                            "if": {
                              "not": {
                                "pattern": "[\\u3400-\\u9fff]{2}"
                              }
                            },
                            "then": {
                              "minLength": 5
                            }
                          }
                        ]
                      }
                    },
                    "risk_dimensions": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "input_variation",
                          "workflow_state",
                          "role_permission",
                          "dependency_failure",
                          "cross_requirement",
                          "side_effect",
                          "retry_recovery",
                          "idempotency",
                          "ambiguity_conflict",
                          "asset_handling",
                          "safety_boundary",
                          "other"
                        ]
                      }
                    },
                    "basis": {
                      "type": "string",
                      "minLength": 12
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "risk_assessments": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "applicable",
          "basis",
          "scenario_ids"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "input_variation",
              "workflow_state",
              "role_permission",
              "dependency_failure",
              "cross_requirement",
              "side_effect",
              "retry_recovery",
              "idempotency",
              "ambiguity_conflict",
              "asset_handling",
              "safety_boundary",
              "other"
            ]
          },
          "applicable": {
            "type": "boolean"
          },
          "basis": {
            "type": "string",
            "minLength": 12
          },
          "scenario_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "applicable": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "scenario_ids": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "applicable": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "scenario_ids": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "impact",
          "validation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 3
          },
          "impact": {
            "type": "string",
            "minLength": 3
          },
          "validation": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "purpose",
          "required",
          "availability",
          "failure_behavior",
          "requirement_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "purpose": {
            "type": "string",
            "minLength": 5
          },
          "required": {
            "type": "boolean"
          },
          "availability": {
            "type": "string",
            "minLength": 5
          },
          "failure_behavior": {
            "type": "string",
            "minLength": 8
          },
          "requirement_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "blocking_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "decision_owner",
          "impact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 8
          },
          "decision_owner": {
            "type": "string",
            "minLength": 2
          },
          "impact": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "target_obligations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sources",
        "obligations",
        "coverage_gaps"
      ],
      "properties": {
        "schema_version": {
          "const": "skill-refiner.target-obligations/v1"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "content_sha256",
              "obligation_ids"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^standard-[1-9][0-9]*$"
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "obligation_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "subject",
              "applicable",
              "applicability_reason",
              "behavior",
              "source",
              "acceptance_criteria",
              "scenario_ids",
              "workflow_ids",
              "mechanism"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^O-[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "subject": {
                "enum": [
                  "target",
                  "controller"
                ]
              },
              "applicable": {
                "type": "boolean"
              },
              "applicability_reason": {
                "type": "string",
                "minLength": 8
              },
              "behavior": {
                "type": "string",
                "minLength": 8
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "content_sha256",
                  "quote"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "pattern": "^standard-[1-9][0-9]*$"
                  },
                  "content_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 8
                  }
                }
              },
              "acceptance_criteria": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "statement",
                    "evidence"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 8
                    },
                    "evidence": {
                      "type": "string",
                      "minLength": 8
                    }
                  }
                }
              },
              "scenario_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "workflow_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mechanism": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "interface",
                  "evidence_strategy",
                  "gap_ids"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "planned",
                      "blocked",
                      "not_applicable"
                    ]
                  },
                  "interface": {
                    "type": "string",
                    "minLength": 8
                  },
                  "evidence_strategy": {
                    "type": "string",
                    "minLength": 8
                  },
                  "gap_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "coverage_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "obligation_ids",
              "scenario_ids",
              "reason",
              "required_evidence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "obligation_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "scenario_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": "string",
                "minLength": 8
              },
              "required_evidence": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.analysis-v4",
  "x-schema-version": "v4"
}
