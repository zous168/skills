{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provisional case deletion assessments v1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "case_id",
      "source_plan_sha256",
      "allow_removal",
      "reason",
      "evidence"
    ],
    "properties": {
      "case_id": {
        "type": "string",
        "minLength": 1
      },
      "source_plan_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "allow_removal": {
        "type": "boolean"
      },
      "reason": {
        "type": "string",
        "minLength": 12
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "quote"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "quote": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
