{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "change_id",
      "previous_plan_sha256",
      "plan_sha256",
      "preserves_prior",
      "supported_by_source",
      "reason",
      "evidence"
    ],
    "properties": {
      "change_id": {
        "type": "string",
        "minLength": 1
      },
      "previous_plan_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "plan_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "preserves_prior": {
        "type": "boolean"
      },
      "supported_by_source": {
        "type": "boolean"
      },
      "reason": {
        "type": "string",
        "minLength": 12
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "source_sha256",
            "quote"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "quote": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
