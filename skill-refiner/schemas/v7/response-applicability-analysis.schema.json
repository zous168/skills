{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner.response-applicability-analysis/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessments"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-refiner.response-applicability-analysis/v1"
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "decision",
          "reason",
          "evidence"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "required",
              "not_required",
              "uncertain"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "quote"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            }
          }
        }
      }
    }
  }
}
